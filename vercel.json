{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/images/Banner.png"]
      }
    },
    {
      "src": "./src/newsLetter.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.js"
    },
    {
      "src": "/data/:key",
      "dest": "/index.js"
    },
    {
      "src": "/otp/:email",
      "dest": "/index.js"
    },
    {
      "src": "/signup/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/getInfo",
      "dest": "/index.js"
    },
    {
      "src": "/Login/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/isItMyPassKey",
      "dest": "/index.js"
    },
    {
      "src": "/newsLetter",
      "dest": "/index.js"
    },
    {
      "src": "/getImage/(.*)",
      "dest": "/index.js"
    },{
      "src":"/Logout",
      "dest":"/index.js"
    }
  ]
}
